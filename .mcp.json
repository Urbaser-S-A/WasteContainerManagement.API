{
  "mcpServers": {
    "deepwiki": {
      "type": "http",
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "mise": {
      "command": "mise",
      "args": [
        "mcp"
      ],
      "env": {
        "MISE_EXPERIMENTAL": "1"
      }
    },
    "aspire": {
      "type": "stdio",
      "command": "aspire",
      "args": [
        "mcp",
        "start"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "pnpm",
      "args": [
        "dlx",
        "@playwright/mcp@latest"
      ]
    },
    "openchoreo-cp": {
      "type": "http",
      "url": "https://api.urbaser.choreo.dev/mcp",
      "oauth": {
        "clientId": "user_mcp_client",
        "callbackPort": 8075
      }
    },
    "openchoreo-obs": {
      "type": "http",
      "url": "https://observer.op.urbaser.choreo.dev/mcp",
      "oauth": {
        "clientId": "user_mcp_client",
        "callbackPort": 8075
      }
    },
    "azure-mcp": {
      "type": "stdio",
      "command": "dotnet",
      "args": [
        "tool",
        "azmcp"
      ]
    }
  }
}