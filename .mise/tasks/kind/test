#!/usr/bin/env bash
#MISE description="Run API smoke tests against the kind cluster"
#MISE depends=["kind:seed"]
set -euo pipefail
# shellcheck source=_helpers.sh
source "$(dirname "$0")/_helpers.sh"

CLUSTER_NAME="${CLUSTER_NAME:-wcm-test}"
KUBE_CTX="kind-${CLUSTER_NAME}"

_info "Running smoke tests…"
api_pod="$(kubectl get pods \
  -l "app.kubernetes.io/name=wcm-api,!app.kubernetes.io/component" \
  -o jsonpath='{.items[0].metadata.name}' --context "$KUBE_CTX")"

# Port-forward in background
kubectl port-forward "$api_pod" 18080:8080 --context "$KUBE_CTX" &>/dev/null &
pf_pid=$!
trap "kill $pf_pid 2>/dev/null || true" EXIT
sleep 2

base="http://localhost:18080"
failed=0

_assert_http() {
  local path="$1" expect_code="${2:-200}" label="${3:-$1}"
  local code
  code="$(curl -s -o /dev/null -w '%{http_code}' "${base}${path}")"
  if [[ "$code" == "$expect_code" ]]; then
    _ok "$label → $code"
  else
    _err "$label → $code (expected $expect_code)"
    failed=1
  fi
}

_assert_http "/health"              200 "Health"
_assert_http "/alive"               200 "Liveness"
_assert_http "/api/v1/zones"        200 "Zones"
_assert_http "/api/v1/waste-types"  200 "WasteTypes"
_assert_http "/api/v1/containers"   200 "Containers"

kill $pf_pid 2>/dev/null || true
trap - EXIT

if [[ "$failed" -eq 1 ]]; then
  _err "Some tests failed"
  exit 1
fi
_ok "All smoke tests passed"
