#!/usr/bin/env bash
#MISE description="Apply SQL init + seed scripts to the running PostgreSQL"
#MISE alias="ks"
#MISE depends=["kind:up"]
set -euo pipefail
# shellcheck source=_helpers.sh
source "$(dirname "$0")/_helpers.sh"

CLUSTER_NAME="${CLUSTER_NAME:-wcm-test}"
KUBE_CTX="kind-${CLUSTER_NAME}"

_info "Seeding database…"
pg_pod="$(kubectl get pods -l app.kubernetes.io/component=postgresql \
  -o jsonpath='{.items[0].metadata.name}' --context "$KUBE_CTX")"

for sql_file in "$SQL_DIR"/0*.sql; do
  fname="$(basename "$sql_file")"
  kubectl cp "$sql_file" "default/${pg_pod}:/tmp/${fname}" --context "$KUBE_CTX"
  kubectl exec "$pg_pod" --context "$KUBE_CTX" -- \
    psql -U postgres -d wcmdb -f "/tmp/${fname}" 2>&1 | tail -1
  _ok "$fname"
done
